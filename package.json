{
  "name": "@arkveil/cli",
  "version": "1.4.1",
  "description": "Command-line interface for the Arkveil Kernel API (navigation, actions, targets, policies, tests, and ABAC operations).",
  "type": "module",
  "bin": {
    "arkveil": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "gen:api": "openapi-typescript https://api.arkveil.com/api/v1/api-docs.yaml --output src/lib/generated/schema.d.ts --empty-objects-unknown --root-types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "arkveil",
    "abac",
    "cli",
    "authorization",
    "policy",
    "openapi"
  ],
  "author": "Dan Zabrotski",
  "license": "MIT",
  "homepage": "https://github.com/arkveil-abac/arkveil-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkveil-abac/arkveil-cli.git"
  },
  "bugs": {
    "url": "https://github.com/arkveil-abac/arkveil-cli/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.7.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "commander": "^12.1.0",
    "eslint": "^9.13.0",
    "open": "^10.1.0",
    "openapi-fetch": "^0.13.0",
    "openapi-typescript": "^7.4.0",
    "ora": "^8.1.0",
    "picocolors": "^1.1.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
